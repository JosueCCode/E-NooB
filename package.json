{
  "name": "casa-clara-financas",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node backend/src/server.js",
    "check": "node --check backend/src/server.js",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "db:seed": "node backend/scripts/seed.js",
    "start": "node backend/src/server.js",
    "vercel-build": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  },
  "prisma": {
    "schema": "database/prisma/schema.prisma",
    "seed": "node backend/scripts/seed.js"
  }
}
